{
  "suggest.noselect": true,
  "coc.preferences.formatOnSave": true,
  "diagnostic.enableSign": false,
  "diagnostic.enableMessage": "jump",
  "diagnostic.checkCurrentLine": true,
  "diagnostic.errorSign": "",
  "diagnostic.infoSign": "",
  "diagnostic.hintSign": "",
  "diagnostic.warningSign": "",
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "python.formatting.provider": "ruff",
  "pyright.disableCompletion": true,
  "pyright.disableDiagnostics": true,
  "snippets.ultisnips.pythonPrompt": false,
  "rust-analyzer.enable": true,
  "Lua.workspace.library": [
    "/usr/local/share/nvim/runtime/lua",
    "/usr/local/share/nvim/runtime/lua/vim",
    "/usr/local/share/nvim/runtime/lua/vim/lsp"
  ],
  "Lua.diagnostics.globals": ["use", "vim"],
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.cargo.features": "all",
  "typescript.preferences.importModuleSpecifier": "non-relative"
}
